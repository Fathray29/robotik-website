rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Cek apakah user sudah login sebagai Admin
    function isAdmin() {
      return request.auth != null;
    }

    // 1. Pengaturan Pendaftaran (Settings)
    match /settings/registration {
      allow read: if true;           // Semua pengunjung bisa membaca status pembukaan & countdown
      allow write: if isAdmin();     // Hanya admin yang bisa mengubah pengaturan pendaftaran
    }

    // 2. Konten Halaman Utama (Landing Page)
    match /landing/content {
      allow read: if true;           // Semua pengunjung bisa membaca teks landing page
      allow write: if isAdmin();     // Hanya admin yang bisa mengubah konten landing page
    }

    // 3. Artikel Blog
    match /blog/articles {
      allow read: if true;           // Semua pengunjung bisa membaca artikel blog
      allow write: if isAdmin();     // Hanya admin yang bisa menulis & menyunting artikel
    }

    // 4. Proyek Portofolio
    match /portfolio/projects {
      allow read: if true;           // Semua pengunjung bisa melihat galeri portofolio
      allow write: if isAdmin();     // Hanya admin yang bisa menambah & menyunting proyek
    }

    // 5. Statistik Pengunjung (Telemetry)
    match /telemetry/visitors {
      allow read: if true;           // Semua pengunjung bisa membaca jumlah counter pengunjung
      // Only allow updates (not create/delete), and only allow incrementing numeric counter fields.
      // This prevents attackers from overwriting or deleting the entire telemetry document.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['count', 'applicantsCount'])
                    && request.resource.data.count is int
                    && request.resource.data.applicantsCount is int
                    && request.resource.data.count >= resource.data.count
                    && request.resource.data.applicantsCount >= resource.data.applicantsCount;
      // Allow creation of telemetry if it does not exist (for initial setup/seeding)
      allow create: if request.resource.data.keys().hasOnly(['count', 'applicantsCount'])
                    && request.resource.data.count is int
                    && (!('applicantsCount' in request.resource.data) || request.resource.data.applicantsCount is int);
    }

    // 6. Data Pendaftar (Applicants)
    // SECURITY NOTE: Registration IDs use crypto.getRandomValues (alphanumeric, 8 chars)
    // making brute-force enumeration computationally infeasible (~2.8 trillion combinations).
    match /applicants/{applicantId} {
      allow get: if true;            // Pengunjung boleh cek status pendaftarannya secara spesifik menggunakan ID (ROBO-xxxxxxxx)
      allow create: if true;         // Pengunjung diperbolehkan mendaftar (membuat entri pendaftar baru)
      
      allow list: if isAdmin();      // Hanya admin yang diperbolehkan menampilkan seluruh daftar pendaftar
      allow update: if isAdmin();    // Hanya admin yang bisa menyetujui (Approve) atau menolak (Reject) pendaftar
      allow delete: if isAdmin();    // Hanya admin yang bisa menghapus data pendaftar
    }
  }
}
